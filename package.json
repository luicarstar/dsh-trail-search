{
  "name": "dsh-trail-search",
  "version": "1.0.1",
  "description": "Persistent link trails, site strategies and QueueItemProvider for DSH",
  "private": true,
  "type": "module",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "src/", "skills/"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/luicarstar/dsh-trail-search.git" },
  "keywords": ["dsh", "dsh-plugin", "trail", "crawler", "osint", "link-graph", "queue-provider"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
